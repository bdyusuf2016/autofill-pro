{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage", "activeTab", "scripting", "commands", "alarms"],
  "host_permissions": ["<all_urls>", "https://prsghqqtlgkjjmywmvgw.supabase.co/*"],
  "web_accessible_resources": [
    {
      "resources": ["about.html", "about.js", "options.css", "supabase-config.js", "supabase-auth.js", "supabase-sync.js", "login.html", "login.js", "welcome.html", "welcome.js", "pdf-parser.js", "ocr-parser.js", "teletalk-mapper-v2.js", "crypto-helper.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["url-rule-matcher.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "__MSG_shortcutCtrlShiftA__"
    },
    "open_autofill_list": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "__MSG_shortcutOpenAutofillList__"
    },
    "fill_active_profile": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_shortcutCtrlAltF__"
    },
    "select_profile_to_fill": {
      "description": "__MSG_commandSelectProfileToFill__"
    }
  }
}
